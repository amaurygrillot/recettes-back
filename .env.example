# Copy this file to .env (gitignored - never commit it) and fill in real values.
#
# It is read as a Java .properties file by `spring.config.import=optional:file:.env[.properties]`, so
# NEVER quote a value, even one with spaces (e.g. a Gmail app password): the quotes would become part
# of the value and silently break authentication.

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=change-me

# SMTP account the password-reset email is sent from
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-app-password

# Grants ADMIN to this EXISTING account at startup (ReferenceDataSeeder). Leave blank to disable.
# app.bootstrap.admin-username=

# Swagger UI (/swagger-ui.html) and /v3/api-docs. Off unless this is true - see docs/openapi.md
# SPRINGDOC_ENABLED=true

# CORS - the browser origins allowed to call the API: a comma-separated list, each written exactly as
# a browser sends it (scheme://host[:port], no path, no trailing slash). Never *.
# Defaults to the Vite dev server. See docs/cors.md
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://recettes.example.com

# Frontend page the password-reset email links to; ?token=...&email=... is appended.
# Defaults to the Vite dev server. In production, the public URL of the frontend's reset page.
# FRONTEND_RESET_URL=https://recettes.example.com/reset-password
