# Root of the Lombok config hierarchy for this project.
config.stopBubbling = true

# Marks Lombok-generated methods with @lombok.Generated, which JaCoCo skips.
# Without this, every @Getter/@Setter on an entity counts as uncovered lines and
# the 90% line-coverage gate in pom.xml measures generated boilerplate instead of
# the hand-written code it is meant to protect. The recipes feature adds sixteen
# entities, which is where that stops being a rounding error.
lombok.addLombokGeneratedAnnotation = true
