### 21. Delete it as its author -> 204 No Content
### Cascades to steps, groups, ingredient lines and picture links; merely dereferences the
### ingredients, tags, categories and media, which all survive.
DELETE {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}

> {%
    client.test("Returns 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

