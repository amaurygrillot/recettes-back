### 23. A recipe with pictures -> 201 Created
### Upload two images via media.http first and paste their ids below. Media is uploaded
### independently and referenced by id; the array order decides which cover is the thumbnail
### shown in a listing.
@coverMediaId = paste-a-media-id-from-media-http
@stepMediaId = paste-another-media-id-from-media-http
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Tarte illustrée",
  "categoryIds": ["{{categoryId}}"],
  "coverPictures": [
    {"mediaId": "{{coverMediaId}}", "altText": "La tarte sortie du four"}
  ],
  "steps": [
    {
      "instruction": "Disposer les pommes",
      "pictures": [{"mediaId": "{{stepMediaId}}", "altText": "Rosace de pommes"}]
    }
  ]
}

> {%
    client.test("Returns 201 with the pictures attached", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.global.set("illustratedRecipeId", response.body.id);
    });
%}

### 24. The listing exposes the FIRST cover as the thumbnail -> 200 OK
GET {{baseUrl}}/recipes?title=illustr

> {%
    client.test("Summary carries coverMediaId", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        const row = response.body.content.find(r => r.id === client.global.get("illustratedRecipeId"));
        client.assert(row.coverMediaId !== null, "Expected a cover media id");
    });
%}

### 25. Clean up
DELETE {{baseUrl}}/recipes/{{illustratedRecipeId}}
Authorization: Bearer {{authorToken}}
