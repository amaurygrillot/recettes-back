### Recipes
### Covers: GET /recipes, GET /recipes/{id}, POST /recipes, PUT /recipes/{id}, DELETE /recipes/{id}
###
### GET /recipes takes its criteria as a request object bound from the query string: title,
### authorId, authorName, categoryId, categoryName, includeSubcategories, tagId, tagName, sortBy,
### direction - plus the
### usual page and size. Every one is optional, including all of them at once.
###
### Reads are public. Writing needs a login; editing or deleting needs to be the AUTHOR or an
### ADMIN - a rule that depends on a row in the database, so no URL matcher expresses it and
### RecipeService performs it after loading the recipe.
###
### Prerequisites: two accounts (an author and a second plain user), an admin, and at least one
### category. Run categories.http first, or paste ids below.

@baseUrl = http://localhost:8080
@authorUsername = jane
@authorPassword = Password123
@otherUsername = bob
@otherPassword = Password123
@adminUsername = admin
@adminPassword = Password123

### 1. Log in as the author -> 200 OK
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{authorUsername}}",
  "password": "{{authorPassword}}"
}

> {%
    client.test("Returns 200 with a token", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.global.set("authorToken", response.body);
    });
%}

### 2. Log in as a different plain user -> 200 OK
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{otherUsername}}",
  "password": "{{otherPassword}}"
}

> {%
    client.test("Returns 200 with a token", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.global.set("otherToken", response.body);
    });
%}

### 3. Log in as an admin -> 200 OK
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("Returns 200 with a token", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.global.set("adminToken", response.body);
    });
%}

### 4. Grab a category, a tag, a unit and an ingredient to build a recipe from
GET {{baseUrl}}/categories

> {%
    client.test("At least one category exists", function () {
        client.assert(response.body.length > 0,
            "Create a category first - see categories.http");
        client.global.set("categoryId", response.body[0].id);
    });
%}

###
GET {{baseUrl}}/units

> {%
    client.test("The seeded units are there", function () {
        client.global.set("unitId", response.body[0].id);
    });
%}

###
POST {{baseUrl}}/ingredients
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "name": "Farine T55"
}

> {%
    client.test("Created or already present", function () {
        if (response.status === 201) {
            client.global.set("ingredientId", response.body.id);
        }
        client.assert(response.status === 201 || response.status === 409,
            "Expected 201 or 409 but got " + response.status);
    });
%}

### 5. Create a full recipe -> 201 Created
### Note there is no authorId in the body: the author is the authenticated caller, stamped by
### JPA auditing. Accepting one here would let anyone post under someone else's name.
### Note also that no element carries a "position": the ORDER OF EACH ARRAY is the contract, and
### the service renumbers 0..n-1 from it.
### "introduction" is the block rendered above everything else. It is optional and has an id of
### its own, which is what makes it a SECTION rather than another field on the recipe - contrast
### "recommendations" below, a plain string rendered beside the recipe.
### ingredientGroups and steps must each hold at least one entry: a recipe with neither is not an
### unfinished recipe, it is one nobody can cook.
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Tarte aux pommes",
  "introduction": {"text": "<p>La tarte de ma grand-mère, en plus simple.</p>"},
  "recommendations": "Se déguste tiède, avec une boule de glace vanille.",
  "categoryIds": ["{{categoryId}}"],
  "tagIds": [],
  "ingredientGroups": [
    {
      "title": "Pour la pâte",
      "ingredients": [
        {"ingredientId": "{{ingredientId}}", "quantity": 250, "unitId": "{{unitId}}"},
        {"ingredientId": "{{ingredientId}}", "note": "pour le plan de travail"}
      ]
    },
    {
      "title": "Pour la garniture",
      "ingredients": [
        {"ingredientId": "{{ingredientId}}", "quantity": 0.5, "unitId": "{{unitId}}"}
      ]
    }
  ],
  "steps": [
    {"instruction": "Préchauffer le four à 180 °C"},
    {"instruction": "Étaler la pâte"},
    {"instruction": "Couper les pommes en lamelles"},
    {"instruction": "Disposer les pommes en rosace"},
    {"instruction": "Enfourner 40 min"}
  ]
}

> {%
    client.test("Returns 201 with the steps in the order they were sent", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.global.set("recipeId", response.body.id);
        const steps = response.body.steps.map(s => s.instruction);
        client.assert(steps[0].startsWith("Préchauffer") && steps[4].startsWith("Enfourner"),
            "Step order was not preserved: " + JSON.stringify(steps));
        client.assert(response.body.introduction.text.includes("grand-mère"),
            "Expected the introduction to come back as its own section");
        client.assert(response.body.introduction.id !== undefined,
            "The introduction is addressable and carries an id");
    });
%}

### 6. Read it back with NO credentials -> 200 OK, in the same order
### Recipes are public. This is also the regression a one-step recipe can never catch: the
### collections are Sets, so only @OrderBy("position") puts the ORDER BY into the SQL.
GET {{baseUrl}}/recipes/{{recipeId}}

> {%
    client.test("Returns 200 and preserves order", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        const steps = response.body.steps.map(s => s.instruction);
        client.assert(steps[0].startsWith("Préchauffer"), "Steps came back shuffled");
        client.assert(response.body.ingredientGroups[0].title === "Pour la pâte",
            "Ingredient groups came back shuffled");
        // A null quantity and a null unit are legitimate: "farine, pour le plan de travail".
        client.assert(response.body.ingredientGroups[0].ingredients[1].quantity === null,
            "Expected a null quantity to survive");
    });
%}

### 7. List recipes with no credentials -> 200 OK, a page of summaries
### Summaries are thin on purpose: a list page must not cost one full recipe load per row. Fetch
### coverMediaId as /media/{id}?variant=thumbnail - that variant exists for exactly this page.
GET {{baseUrl}}/recipes?page=0&size=20

> {%
    client.test("Returns a page of summaries", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.content[0].steps === undefined,
            "A summary must not carry steps");
    });
%}

### 8. Filter by category -> the recipe appears exactly ONCE
### The duplicate-row bug this query shape avoids: a join onto a to-many collection returns one
### row per matching category, and a derived COUNT then counts those duplicates. Add a second
### category to the recipe (request 11) and re-run this to see it stay at one.
GET {{baseUrl}}/recipes?categoryId={{categoryId}}

> {%
    client.test("Counts each recipe once", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        const matches = response.body.content.filter(r => r.id === client.global.get("recipeId"));
        client.assert(matches.length === 1, "Expected exactly one row, got " + matches.length);
    });
%}

### 9. Search by title fragment, case-insensitively -> 200 OK
### The parameter is "title", not "q". "q" said nothing about what it searched, and the answer
### was not obvious: it never matched an author or a category, only the title.
GET {{baseUrl}}/recipes?title=POMMES

> {%
    client.test("Finds it regardless of case", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9b. Search by the names a user actually knows -> 200 OK
### Nobody types a UUID into a search box. The id filters are for a UI that just showed the user
### a list to pick from; these are for a user typing. Category and tag names are matched against
### normalized_name, so an unaccented lower-case term finds the accented stored spelling.
GET {{baseUrl}}/recipes?categoryName=dessert&authorName={{authorUsername}}

> {%
    client.test("Finds the recipe by names rather than ids", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9b-i. Filter by a MAIN category -> 200 OK, recipes in its subcategories included
### Categories form a tree, and "show me the desserts" means the whole subtree to anyone not reading the
### schema - so a recipe filed only under "Tartes" is found from "Desserts". includeSubcategories is
### absent here, and absent means TRUE: it is a Boolean rather than a boolean precisely so a client that
### does not know the parameter exists still gets the browsing default. Run categories.http #12-13 first
### to have a subcategory, then file a recipe under it and paste the main category's id below.
@mainCategoryId = paste-the-id-of-a-main-category-that-has-subcategories
GET {{baseUrl}}/recipes?categoryId={{mainCategoryId}}

> {%
    client.test("Returns 200, reaching into the subcategories", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9b-ii. The same, with exact membership -> 200 OK, ONLY recipes filed directly under it
### The admin's question - what is actually in this category before deleting or merging it - rather than
### the browser's. A recipe filed only under a subcategory disappears from this result.
GET {{baseUrl}}/recipes?categoryId={{mainCategoryId}}&includeSubcategories=false

> {%
    client.test("Returns 200 with exact membership", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9b-iii. By category NAME, subcategories included -> 200 OK
### categoryName is widened exactly like categoryId. If both are sent they are UNIONED, not intersected:
### they are two spellings of one filter, what a dropdown sends and what a search box sends.
GET {{baseUrl}}/recipes?categoryName=dessert&includeSubcategories=true

> {%
    client.test("Returns 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9b-iv. A category name that matches NOTHING -> 200 OK, and no recipes at all
### Not "no filter". Answering a misspelled category with the entire library would look to the user like
### the filter being ignored.
GET {{baseUrl}}/recipes?categoryName=categorie-qui-nexiste-pas

> {%
    client.test("Returns an empty page, not everything", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.totalElements === 0,
            "Expected no recipes, got " + response.body.totalElements);
    });
%}

### 9b-v. includeSubcategories that is not a boolean -> 400 Bad Request
GET {{baseUrl}}/recipes?categoryId={{mainCategoryId}}&includeSubcategories=perhaps

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 9c. An unfiltered listing -> 200 OK
### Every criterion is optional and so is all of them: this is the home page, not a 400.
GET {{baseUrl}}/recipes

> {%
    client.test("Returns the newest recipes", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9d. Sort explicitly -> 200 OK
### sortBy is a closed enum (CREATED_AT, UPDATED_AT, TITLE) and direction is independent of it,
### so "oldest first" and "reverse alphabetical" are both already expressible. The default is
### CREATED_AT + DESC.
GET {{baseUrl}}/recipes?sortBy=TITLE&direction=ASC

> {%
    client.test("Orders by title ascending", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 9e. Sort by something that is not on the list -> 400 Bad Request
### NOT a 500. The listing pages over hand-written JPQL and Spring would append whatever property
### a free-text sort named straight into it - so ?sort=bogus used to be a SemanticException, and
### ?sort=author.password would have ordered by a column no response exposes.
GET {{baseUrl}}/recipes?sortBy=bogus

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 10. Update ONLY the title -> 200 OK, categories untouched
### Absent means "don't touch". Half of a pair with request 12 - a suite asserting only one of
### them will not notice if the rule inverts.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Tarte aux pommes de mamie"
}

> {%
    client.test("Returns 200 and keeps the categories", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.categories.length > 0, "Categories were wiped by an absent field");
        client.assert(response.body.steps.length === 5, "Steps were wiped by an absent field");
    });
%}

### 11. Replace the whole step list -> 200 OK
### A present collection replaces it wholesale. That is what makes reordering free.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "steps": [
    {"instruction": "Tout mélanger"},
    {"instruction": "Cuire 45 min"}
  ]
}

> {%
    client.test("Returns 200 with exactly the new steps", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.steps.length === 2, "Expected the list to be replaced");
        client.assert(response.body.steps[0].instruction === "Tout mélanger", "Wrong order");
    });
%}

### 12. Update with an EMPTY category list -> 400 Bad Request
### Empty is a different request from absent, and it is refused: a recipe may not lose its last
### category, or it stops being browsable. Compare with request 13, where clearing every tag is
### fine - same Optional<List<String>> shape, deliberately different rule.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "categoryIds": []
}

> {%
    client.test("Returns 400 and changes nothing", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 12b. Update with an EMPTY step list -> 400 Bad Request
### Same rule as the categories above, for the same reason: an edit must not be able to turn a
### working recipe into one nobody can cook, which a create is already forbidden from producing.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "steps": []
}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 12c. Remove the introduction -> 200 OK, introduction is now null
### Blank text is the delete instruction, and it has to be: Jackson maps a missing property and
### an explicit "introduction": null to the SAME Optional.empty(), so neither of those can mean
### "delete" without also meaning "leave it alone" on every partial update that omits the field.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "introduction": {"text": ""}
}

> {%
    client.test("Returns 200 and the section is gone", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.introduction === null,
            "Expected null, not an object with empty text");
    });
%}

### 12d. Update without mentioning the introduction -> 200 OK, still absent
### Omission means "leave it alone", here as everywhere else in this payload.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Tarte aux pommes de ma grand-mère"
}

> {%
    client.test("Returns 200 and does not resurrect the introduction", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.introduction === null, "Expected it to stay removed");
    });
%}

### 13. Clear every tag -> 200 OK
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "tagIds": []
}

> {%
    client.test("Returns 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 14. Create a recipe referencing an id that does not exist -> 400 Bad Request
### 400 and not 404: /recipes is perfectly reachable, it is the payload that is wrong. The detail
### names the field AND every missing id, so a client with a stale list does not fix one per
### round trip.
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Recette fantôme",
  "categoryIds": ["00000000-0000-0000-0000-000000000000", "11111111-1111-1111-1111-111111111111"]
}

> {%
    client.test("Returns 400 naming every missing id", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.detail.includes("categoryIds"), "Expected the field to be named");
    });
%}

### 15. Create a recipe with no category -> 400 Bad Request
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Sans catégorie",
  "categoryIds": []
}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 15b. Create a recipe with no ingredients at all -> 400 Bad Request
### A recipe nobody can cook is not a half-finished recipe; accepting one only moves the failure
### to the reader.
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Tarte",
  "categoryIds": ["{{categoryId}}"],
  "ingredientGroups": [],
  "steps": [{"instruction": "Mélanger"}]
}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 15c. Create a recipe with no steps at all -> 400 Bad Request
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Tarte",
  "categoryIds": ["{{categoryId}}"],
  "ingredientGroups": [{"ingredients": [{"ingredientId": "{{ingredientId}}"}]}],
  "steps": []
}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 16. Create a recipe with a blank step instruction -> 400 Bad Request
### Guarded by @NotBlank on the child record. Without it this reaches
### recipe_steps.instruction NOT NULL and surfaces as a generic 500.
POST {{baseUrl}}/recipes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{
  "title": "Étape vide",
  "categoryIds": ["{{categoryId}}"],
  "steps": [{"instruction": "   "}]
}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 17. Create a recipe with no token -> 401 Unauthorized
### 401 and not 403 - the regression the explicit AuthenticationEntryPoint guards.
POST {{baseUrl}}/recipes
Content-Type: application/json

{
  "title": "Anonyme",
  "categoryIds": ["{{categoryId}}"]
}

> {%
    client.test("Returns 401", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### 18. Edit someone else's recipe as a different plain user -> 403 Forbidden
### Authenticated, but not the author. This is the rule that depends on a database row.
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "title": "Détournée"
}

> {%
    client.test("Returns 403", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

