### 17. Delete an ingredient a recipe still uses -> 409 Conflict
### Create a recipe using it first (recipes.http), then paste its id here.
@usedIngredientId = paste-an-ingredient-id-that-a-recipe-references
DELETE {{baseUrl}}/ingredients/{{usedIngredientId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Returns 409", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
    });
%}
