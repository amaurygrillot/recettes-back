### 15. List the member's lists -> 200 OK, sorted by name, not paged
### Accents and case do not decide the order. Only the caller's own lists appear: the other member's
### "Pour le dimanche" is not here.
GET {{baseUrl}}/lists
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 200 with the two lists of the member, by name", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length === 2, "Expected 2 lists but got " + response.body.length);
        client.assert(response.body[0].name === "Pour le dimanche", "Expected the lists sorted by name");
        client.assert(response.body[1].name === "Recettes de mamie", "Expected the lists sorted by name");
    });
%}

