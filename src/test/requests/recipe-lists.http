### 17. Rename a list and change its emoji -> 200 OK
### Both fields are required: a PUT replaces, it does not patch. `updatedAt` changes now, and only when the
### name or the emoji does (never when a recipe is added or removed).
PUT {{baseUrl}}/lists/{{listId}}
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "name": "Repas du dimanche",
  "emoji": "🍽️"
}

> {%
    client.test("Returns 200 with the new name", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.name === "Repas du dimanche", "Expected the new name");
        client.assert(response.body.updatedAt !== response.body.createdAt, "Expected updatedAt to have moved");
    });
%}

