### Recipe lists
### Covers: GET /lists, GET /lists?containing=, POST /lists, GET /lists/{id}, PUT /lists/{id}, DELETE /lists/{id},
###         PUT /lists/{id}/recipes/{recipeId}, DELETE /lists/{id}/recipes/{recipeId},
###         the content of a list: GET /recipes?listId=,
###         and the photo of a list's own: PUT, GET and DELETE /lists/{id}/cover (requests 36 to 59)
###
### A list is a member's PRIVATE shelf of recipes, with a name and an emoji. Only its owner can see, change or use
### it: no other member, no visitor, no administrator. Every route needs a token. The reasoning is in
### docs/recipe-lists.md.
###
### The two members below are needed to show the privacy rules: whatever the first one creates, the second one
### gets exactly the answer it would get for a list that does not exist (404), never a 403.
###
### Needs at least two recipes in the library (request 4 picks the two newest). The limits (50 lists, 200 recipes
### per list) are asserted for real by RecipeListsIntegrationTest and RecipeListContentIntegrationTest; requests 29
### and 30 show the two answers and say how to reach them by hand.
###
### The photo section (requests 36 to 59) uploads real files, which a .http file cannot create: put these next to this
### file first (any JPEG/PNG will do, they are only ever read):
###   ./sample.jpg  ./sample-2.jpg  a second, different photo      ./not-an-image.txt  plain text
###   ./photo.heic  any HEIC photo                                   ./too-big.jpg       a file over 8 MB
### The photo is PRIVATE like the list. Reasoning, order of the gates and the cache rules: docs/recipe-list-cover.md.

@baseUrl = http://localhost:8080
@memberUsername = lists-member
@memberPassword = Password123
@memberEmail = lists-member@example.com
@otherUsername = lists-other
@otherPassword = Password123
@otherEmail = lists-other@example.com

### 1. Register the two members -> 201 Created (409 Conflict on a re-run: they already exist, carry on)
POST {{baseUrl}}/users/create
Content-Type: application/json

{
  "username": "{{memberUsername}}",
  "password": "{{memberPassword}}",
  "email": "{{memberEmail}}"
}

> {%
    client.test("Returns 201, or 409 if the member already exists", function () {
        client.assert(response.status === 201 || response.status === 409, "Expected 201 or 409 but got " + response.status);
    });
%}

### 2. Register the other member -> 201 Created (409 on a re-run)
POST {{baseUrl}}/users/create
Content-Type: application/json

{
  "username": "{{otherUsername}}",
  "password": "{{otherPassword}}",
  "email": "{{otherEmail}}"
}

> {%
    client.test("Returns 201, or 409 if the member already exists", function () {
        client.assert(response.status === 201 || response.status === 409, "Expected 201 or 409 but got " + response.status);
    });
%}

### 3. Log in as each member -> 200 OK, a token each
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{memberUsername}}",
  "password": "{{memberPassword}}"
}

> {%
    client.test("Returns 200 with a token", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.global.set("memberToken", response.body);
    });
%}

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{otherUsername}}",
  "password": "{{otherPassword}}"
}

> {%
    client.test("Returns 200 with a token", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.global.set("otherToken", response.body);
    });
%}

### 4. Pick two recipes to file -> 200 OK
### Any two recipes of the library will do. Lists hold other people's recipes as readily as one's own.
GET {{baseUrl}}/recipes?size=2

> {%
    client.test("Returns 200 with at least two recipes", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.content.length >= 2, "Create two recipes first (recipes.http)");
        client.global.set("recipeId", response.body.content[0].id);
        client.global.set("secondRecipeId", response.body.content[1].id);
    });
%}

### 5. List the lists with no token -> 401 Unauthorized
### Every list route needs a token; there is no public read.
GET {{baseUrl}}/lists

> {%
    client.test("Returns 401", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

###
### 5b. ... with a token that is present but broken -> 401 Unauthorized
### What a client holding a token minted before the last restart sends. A broken token is refused even where the
### route alone would have let an anonymous caller through (GET /recipes), so the client knows to log in again.
GET {{baseUrl}}/lists
Authorization: Bearer eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJ4In0.c2lnbmF0dXJl

> {%
    client.test("Returns 401", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

###
### 5c. The same on the public search, but only because of listId -> 401 Unauthorized
GET {{baseUrl}}/recipes?listId=anything
Authorization: Bearer eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJ4In0.c2lnbmF0dXJl

> {%
    client.test("Returns 401", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### 6. Create a list -> 201 Created, with a Location header and the stored list
### The name is trimmed. The emoji is required and must be exactly one emoji. The new list is empty.
POST {{baseUrl}}/lists
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "name": "  Pour le dimanche  ",
  "emoji": "🍝"
}

> {%
    client.test("Returns 201 with an empty list, trimmed", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.name === "Pour le dimanche", "Expected the trimmed name");
        client.assert(response.body.recipeCount === 0, "Expected an empty list");
        client.assert(response.body.recipeCoverMediaIds.length === 0, "Expected no cover yet");
        client.assert(response.body.coverVersion === null, "Expected no photo of its own: a list is created without one");
        client.assert(response.body.containsRecipe === undefined, "containsRecipe only exists with ?containing=");
        client.assert(response.headers.valueOf("Location").endsWith(response.body.id), "Expected a Location");
        client.global.set("listId", response.body.id);
    });
%}

### 7. Create a list with the same name once accents, case and spacing are ignored -> 409 Conflict
### The problem `type` is what tells this conflict from the two limits (requests 29 and 30) - never the detail.
POST {{baseUrl}}/lists
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "name": "pour LE   dimanche",
  "emoji": "🎂"
}

> {%
    client.test("Returns 409 of type recipe-list-name-taken", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
        client.assert(response.body.type === "urn:recettes:problem:recipe-list-name-taken", "Got type " + response.body.type);
    });
%}

### 8. A different member may have a list with the same name -> 201 Created
### Uniqueness is per member.
POST {{baseUrl}}/lists
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "name": "Pour le dimanche",
  "emoji": "🍝"
}

> {%
    client.test("Returns 201", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.global.set("otherListId", response.body.id);
    });
%}

