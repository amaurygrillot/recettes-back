PUT {{baseUrl}}/lists/{{listId}}/recipes/{{secondRecipeId}}
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
