###
GET {{baseUrl}}/lists/{{listId}}
Authorization: Bearer {{memberToken}}

> {%
    client.test("Counts both recipes", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.recipeCount === 2, "Expected 2 recipes but got " + response.body.recipeCount);
        // Up to 4 media ids: the first cover of the most recently added recipes that have one, newest first.
        // Fewer (or none) if those recipes have no picture.
        client.assert(response.body.recipeCoverMediaIds.length <= 4, "Expected at most 4 covers");
    });
%}

### 27. "Which of my lists hold this recipe?" -> 200 OK, with containsRecipe on every item
### What the « Ajouter à une liste » sheet needs. `containsRecipe` exists ONLY when `containing` is given.
GET {{baseUrl}}/lists?containing={{recipeId}}
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 200 with containsRecipe on each list", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        var repas = response.body.find(function (list) { return list.id === client.global.get("listId"); });
        var mamie = response.body.find(function (list) { return list.id === client.global.get("secondListId"); });
        client.assert(repas.containsRecipe === true, "Expected the list holding the recipe to say true");
        client.assert(mamie.containsRecipe === false, "Expected the other list to say false");
    });
%}

###
### 27b. ... with a recipe that does not exist -> 404 Not Found
GET {{baseUrl}}/lists?containing=no-such-recipe
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### 28. Read the content of a list through the recipe search -> 200 OK, most recently added first
### Same cards, paging, search and sorts as the rest of the library. `listId` is combined with AND with every
### other criterion, and is the only criterion that needs a token.
GET {{baseUrl}}/recipes?listId={{listId}}
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns the two recipes, the last one added first", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.totalElements === 2, "Expected 2 recipes");
        client.assert(response.body.content[0].id === client.global.get("secondRecipeId"), "Expected the second recipe first");
        client.assert(response.body.content[1].id === client.global.get("recipeId"), "Expected the first recipe last");
    });
%}

###
### 28b. ... oldest added first -> 200 OK
GET {{baseUrl}}/recipes?listId={{listId}}&sortBy=ADDED_AT&direction=ASC
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns the first recipe added, first", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.content[0].id === client.global.get("recipeId"), "Expected the first recipe first");
    });
%}

###
### 28c. ... sorted by title instead -> 200 OK
GET {{baseUrl}}/recipes?listId={{listId}}&sortBy=TITLE&direction=ASC
Authorization: Bearer {{memberToken}}

> {%
