###
DELETE {{baseUrl}}/lists/{{otherListId}}
Authorization: Bearer {{otherToken}}

> {%
    client.test("Returns 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### ---------------------------------------------------------------------------------------------------------------
### The photo of a list's own
### ---------------------------------------------------------------------------------------------------------------

### 36. Create a list for the photo -> 201 Created, with no photo
POST {{baseUrl}}/lists
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "name": "Recettes de mamie",
  "emoji": "\uD83C\uDF82"
}

> {%
    client.test("Returns 201 with coverVersion null", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.coverVersion === null, "A list is created without a photo");
        client.global.set("photoListId", response.body.id);
    });
%}

### 37. Give the list a photo -> 200 OK, the updated list with a coverVersion
### multipart/form-data with ONE part named file, exactly as POST /media (8 MB at most, JPEG or PNG). It counts as one
### upload against the same per-account limit as POST /media (admins are exempt). It never takes a media id.
PUT {{baseUrl}}/lists/{{photoListId}}/cover
Authorization: Bearer {{memberToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpg"
Content-Type: image/jpeg

< ./sample.jpg
--WebAppBoundary--

> {%
    client.test("Returns 200 with the new version", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(typeof response.body.coverVersion === "string", "Expected a coverVersion");
        client.assert(Array.isArray(response.body.recipeCoverMediaIds), "The mosaic is computed either way");
        client.global.set("coverVersion", response.body.coverVersion);
        // Used by media.http request 15: this id must not be served by GET /media/{id}.
        client.global.set("listPhotoId", response.body.coverVersion);
    });
%}

### 38. Read the list -> 200 OK, the same coverVersion
GET {{baseUrl}}/lists/{{photoListId}}
Authorization: Bearer {{memberToken}}

> {%
    client.test("Shows the version", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.coverVersion === client.global.get("coverVersion"), "Expected the same version");
    });
%}

### 39. Fetch the photo with no version -> 200 OK, private and revalidated
### Without ?v= the browser may keep the photo but must revalidate it: Cache-Control is private, no-cache, never public.
### Fetch it with fetch() and an Authorization header and show it from a blob: an <img src> cannot carry the token.
GET {{baseUrl}}/lists/{{photoListId}}/cover
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 200 with a private, no-cache photo", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        var cacheControl = response.headers.valueOf("Cache-Control");
        client.assert(cacheControl.indexOf("private") >= 0 && cacheControl.indexOf("no-cache") >= 0, "Expected private, no-cache but got " + cacheControl);
        client.assert(cacheControl.indexOf("public") < 0, "A list's photo is never public");
        client.assert(response.headers.valueOf("X-Content-Type-Options") === "nosniff", "Expected nosniff");
        client.global.set("photoEtag", response.headers.valueOf("ETag"));
    });
%}

### 40. Fetch it with the current version, the thumbnail size -> 200 OK, private and immutable
### Each version has its own URL, so a replaced photo can never come back from a cache.
GET {{baseUrl}}/lists/{{photoListId}}/cover?v={{coverVersion}}&variant=thumbnail
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 200, private and immutable", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        var cacheControl = response.headers.valueOf("Cache-Control");
        client.assert(cacheControl.indexOf("private") >= 0 && cacheControl.indexOf("immutable") >= 0, "Expected private, immutable but got " + cacheControl);
        client.assert(cacheControl.indexOf("public") < 0, "A list's photo is never public");
    });
%}

### 41. Ask again with its ETag -> 304 Not Modified, repeating the Cache-Control
### A browser does this by itself. A script must NOT set If-None-Match: the browser then bypasses its cache.
GET {{baseUrl}}/lists/{{photoListId}}/cover
Authorization: Bearer {{memberToken}}
If-None-Match: {{photoEtag}}

> {%
    client.test("Returns 304, still private", function () {
        client.assert(response.status === 304, "Expected 304 but got " + response.status);
        client.assert(response.headers.valueOf("Cache-Control").indexOf("private") >= 0, "A 304 repeats the Cache-Control");
    });
%}

### 42. Fetch a version that never existed -> 404 Not Found
GET {{baseUrl}}/lists/{{photoListId}}/cover?v=never-existed
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### 43. Ask for a size that does not exist -> 400 Bad Request
GET {{baseUrl}}/lists/{{photoListId}}/cover?variant=enormous
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 44. Replace the photo -> 200 OK, a NEW coverVersion
### The old photo is deleted, its row and both files, once this commits.
PUT {{baseUrl}}/lists/{{photoListId}}/cover
Authorization: Bearer {{memberToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample-2.jpg"
Content-Type: image/jpeg

< ./sample-2.jpg
--WebAppBoundary--

> {%
    client.test("Returns 200 with a different version", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.coverVersion !== client.global.get("coverVersion"), "Expected a new version");
        client.global.set("staleVersion", client.global.get("coverVersion"));
        client.global.set("coverVersion", response.body.coverVersion);
        client.global.set("listPhotoId", response.body.coverVersion);
    });
%}

### 45. Fetch the OLD version -> 404 Not Found
### A stale version is never served, under a long cache or any other: the front reloads the list.
GET {{baseUrl}}/lists/{{photoListId}}/cover?v={{staleVersion}}
Authorization: Bearer {{memberToken}}

> {%
    client.test("Returns 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### 46. Another member asks for the photo -> 404 Not Found
### Never the bytes, never a 403: the answer is that of a list that does not exist. Visibility is checked before
### If-None-Match, so a matching ETag from this member is a 404 too, never a 304.
GET {{baseUrl}}/lists/{{photoListId}}/cover
Authorization: Bearer {{otherToken}}
If-None-Match: {{photoEtag}}

> {%
    client.test("Returns 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

