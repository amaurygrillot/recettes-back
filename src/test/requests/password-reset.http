### Password reset ("forgot password") flow
### Covers: POST /auth/reinit-password, PUT /users/reinit-password
### See docs/password-reset.md for the security rationale behind the status codes used here.

@baseUrl = http://localhost:8080
@registeredEmail = liguepk74@gmail.com
@unknownEmail = ghost@example.com

### 1. Request a reset for a registered email -> 202 Accepted, an email is sent
POST {{baseUrl}}/auth/reinit-password
Content-Type: application/json

{
  "email": "{{registeredEmail}}"
}

> {%
    client.test("Returns 202 Accepted", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

### 2. Request a reset for an email that isn't registered -> still 202 Accepted
### Must respond identically to #1: this is the enumeration-protection guarantee
### documented in docs/password-reset.md, not a bug.
POST {{baseUrl}}/auth/reinit-password
Content-Type: application/json

{
  "email": "{{unknownEmail}}"
}

> {%
    client.test("Returns 202 Accepted even for an unknown email", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

### 3. Request a reset with a blank email -> 400 Bad Request (validation failure)
POST {{baseUrl}}/auth/reinit-password
Content-Type: application/json

{
  "email": ""
}

> {%
    client.test("Returns 400 for a blank email", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 3b. Request a reset with an email of exactly 254 characters -> 202 Accepted
### The limit is 254 (RFC 5321) on every route that takes an email, the same as at registration -
### a shorter limit here would let someone register an address they could never reset a password for.
### The address is built by the pre-request script (IntelliJ HTTP Client syntax; the VS Code REST Client
### has no scripting - paste a 254-character address instead). It is not registered, hence the plain 202.
< {%
    const domain = "@example.com";
    request.variables.set("email254", "a".repeat(254 - domain.length) + domain);
    request.variables.set("email255", "a".repeat(255 - domain.length) + domain);
%}
POST {{baseUrl}}/auth/reinit-password
Content-Type: application/json

{
  "email": "{{email254}}"
}

> {%
    client.test("Returns 202 for a 254-character email", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

### 3c. Request a reset with an email of 255 characters -> 400 Bad Request
### Run right after 3b: it reuses the variables 3b's pre-request script set.
POST {{baseUrl}}/auth/reinit-password
Content-Type: application/json

{
  "email": "{{email255}}"
}

> {%
    client.test("Returns 400 for a 255-character email", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 4. Complete the reset with an unknown token -> 400 Bad Request
PUT {{baseUrl}}/users/reinit-password
Content-Type: application/json

{
  "email": "{{registeredEmail}}",
  "token": "not-a-real-token",
  "newPassword": "NewSecurePassword123"
}

> {%
    client.test("Returns 400 for an unknown token", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 5. Complete the reset for an email that isn't registered -> 400 Bad Request
### Same status as #4: a caller can't tell "wrong email" from "wrong token" apart.
PUT {{baseUrl}}/users/reinit-password
Content-Type: application/json

{
  "email": "{{unknownEmail}}",
  "token": "not-a-real-token",
  "newPassword": "NewSecurePassword123"
}

> {%
    client.test("Returns 400 for an unregistered email", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}



### 5b. Complete the reset with an email of 255 characters -> 400 Bad Request (validation failure)
### One over the 254 limit; a 254-character address passes validation and fails like #5 (unknown email).
### Reuses the {{email255}} variable set by 3b's pre-request script, so run 3b first.
PUT {{baseUrl}}/users/reinit-password
Content-Type: application/json

{
  "email": "{{email255}}",
  "token": "not-a-real-token",
  "newPassword": "NewSecurePassword123"
}

> {%
    client.test("Returns 400 for a 255-character email", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 6. Complete the reset with a new password that's too short -> 400 Bad Request (validation failure)
@resetToken = tP2xiuGSrtRLW9mS7zSKeEoVfrHWFrWKzHPMwJtTBrU
PUT {{baseUrl}}/users/reinit-password
Content-Type: application/json

{
  "email": "{{registeredEmail}}",
  "token": "{{resetToken}}",
  "newPassword": "short"
}

> {%
    client.test("Returns 400 for a too-short password", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 7. Complete the reset with a genuinely valid token -> 200 OK
### Can't be scripted end-to-end: the raw token only ever exists in the emailed link
### (see SmtpMailService), never in an HTTP response. Run request #1 above, grab the
### token from the received email (or, in local dev, the SMTP debug output), paste it
### below, then run this request manually.

PUT {{baseUrl}}/users/reinit-password
Content-Type: application/json

{
  "email": "{{registeredEmail}}",
  "token": "{{resetToken}}",
  "newPassword": "NewSecurePassword123"
}

### 8. Replay the same token -> 400 Bad Request (tokens are single-use)
### Run immediately after #7 succeeds, with the same {{resetToken}} still in place.
PUT {{baseUrl}}/users/reinit-password
Content-Type: application/json

{
  "email": "{{registeredEmail}}",
  "token": "{{resetToken}}",
  "newPassword": "AnotherPassword456"
}

> {%
    client.test("Returns 400 when the token is replayed", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}
